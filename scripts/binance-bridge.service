[Unit]
Description=Phase 19 Binance VPS->Convex bridge (aria -> project-hub-app Convex)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Must run as root: /root/.local/bin/codex-vault-exec is mode 700 root:root by
# design (bootstrap vault credential lives in root's password store) — the
# `ubuntu` user gets a bare "Permission denied" trying to exec it at all.
User=root
WorkingDirectory=/home/ubuntu/project-hub-app
ExecStart=/root/.local/bin/vault-run --project binance-bridge -- /usr/bin/env node /home/ubuntu/project-hub-app/scripts/binance-bridge.mjs
# Binance API key/secret are injected at exec time from the central VPS vault via
# the manifest /root/.config/vault-manifests/binance-bridge.toml (service scope
# "binance"), driven by `vault-run` (a thin composition layer over codex-vault-exec).
# Values are never stored in this unit or in a .env file. Verify the keys exist with
# `vault-doctor --project binance-bridge`. The bridge (auth) token is separate: read
# from scripts/.binance-bridge-token (gitignored) or BINANCE_BRIDGE_TOKEN env.
TimeoutStartSec=60
